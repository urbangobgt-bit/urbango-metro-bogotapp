   <Column ss:Width="260"/>
   <Column ss:Width="180"/>
   <Column ss:Width="140"/>
   <Column ss:Width="130"/>
   <Column ss:Width="110"/>
   <Column ss:Width="100"/>
   <Row ss:Height="25">
